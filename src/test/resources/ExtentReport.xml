<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite  name="GroupTest" verbose="1">
    <groups>
        <run>
            <include name="ErrorValidation"/>
        </run>
    </groups>
    <listeners>
        <listener class-name="com.automation.testcomponents.ListenersTest"/>
    </listeners>
    <test name="Test" thread-count="2">
        <classes>
            <class name="com.automation.tests.ErrorValidationTest"/>
        </classes>
    </test>
</suite>
