<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!--        parallel="methods"-->
<suite  name="ParallelTest" parallel="classes" verbose="1">    <!--parllel="tests or methods or classes"-->
    <listeners>
        <listener class-name="com.automation.testcomponents.ListenersTest"/>
    </listeners>
    <test name="Test" thread-count="2">
        <groups>
            <run>
                <exclude name="ErrorValidation"/>
                <include name="dataProviderTest"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.OrderHistoryTest"/>
            <class name="com.automation.tests.ErrorValidationTest"/>
        </classes>
    </test>
</suite>
